    {
      "name": "B. Registro y login (validacion del backend)",
      "item": [
        {
          "name": "WEB-01 · POST /auth/registro valido -> 200 con token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('WEB-01 · POST /auth/registro responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('WEB-06 · la respuesta incluye token y refreshToken', function () {",
                  "    const d = pm.response.json().data;",
                  "    pm.expect(d).to.have.property('token');",
                  "    pm.expect(d).to.have.property('refreshToken');",
                  "    pm.expect(d).to.have.property('usuario');",
                  "});",
                  "pm.test('WEB-06 · la respuesta NO expone el hash de la contrasena', function () {",
                  "    const s = pm.response.text().toLowerCase();",
                  "    pm.expect(s).to.not.include('password');",
                  "    pm.expect(s).to.not.include('$2a$');",
                  "    pm.expect(s).to.not.include('$2b$');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('tokenUser', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
