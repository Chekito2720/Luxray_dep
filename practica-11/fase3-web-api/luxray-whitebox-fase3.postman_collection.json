{
  "info": {
    "name": "LuxRay — White Box Fase 3 (contratos HTTP del API Gateway)",
    "description": "PRÁCTICA 11 — Fase 3. Colección Newman/Postman que verifica el comportamiento interno de los endpoints del proyecto LuxRay: códigos HTTP correctos, validación del backend, autenticación (401) vs autorización (403), consistencia de la estructura JSON y ausencia de datos sensibles en las respuestas.\n\nLos assertions codifican el COMPORTAMIENTO CORRECTO según la matriz de la práctica (200/201/400/401/403/404/409/422/500). Un assertion fallido NO es un fallo de la herramienta: es evidencia de un defecto del backend, documentado en `practica-11/fase6-defectos/`.\n\nEjecución:\n  newman run luxray-whitebox-fase3.postman_collection.json \\\n    -e baseUrl=http://localhost:8080/api \\\n    --reporters cli,json --reporter-json-export ../evidencias/fase3_newman.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api", "type": "string" },
    { "key": "usuarioEmail", "value": "wb11_user@luxray.test", "type": "string" },
    { "key": "usuarioPassword", "value": "ClaveSegura123", "type": "string" },
    { "key": "tokenAdmin", "value": "", "type": "string" },
    { "key": "tokenUser", "value": "", "type": "string" },
    { "key": "cursoId", "value": "", "type": "string" },
    { "key": "emailUnico", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Cada peticion de registro usa un correo unico para poder repetirse.",
          "if (!pm.collectionVariables.get('emailUnico')) {",
          "  const sufijo = Date.now() + '_' + Math.floor(Math.random()*1000);",
          "  pm.collectionVariables.set('emailUnico', 'wb11_' + sufijo + '@luxray.test');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "A. Lectura publica (sin autenticacion)",
      "item": [
        {
          "name": "WEB-01 · GET /cursos -> 200 con lista de cursos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('WEB-01 · GET /cursos responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('WEB-06 · la respuesta usa la envoltura {data, success, message}', function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b).to.have.property('data');",
                  "    pm.expect(b).to.have.property('success');",
                  "});",
                  "pm.test('WEB-06 · cada curso tiene id, titulo y nivel', function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.data).to.be.an('array');",
                  "    b.data.forEach(c => {",
                  "        pm.expect(c).to.have.property('id');",
                  "        pm.expect(c).to.have.property('titulo');",
                  "        pm.expect(c).to.have.property('nivel');",
                  "    });",
                  "});",
                  "pm.test('WEB-06 · no se exponen campos sensibles', function () {",
                  "    const s = pm.response.text().toLowerCase();",
                  "    pm.expect(s).to.not.include('password_hash');",
                  "    pm.expect(s).to.not.include('passwordhash');",
                  "    pm.expect(s).to.not.include('\"secret\"');",
                  "    pm.expect(s).to.not.include('jdbc:');",
                  "});",
                  "if (pm.response.code === 200 && pm.response.json().data.length) {",
                  "    pm.collectionVariables.set('cursoId', pm.response.json().data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/cursos", "host": ["{{baseUrl}}"], "path": ["cursos"] }
          }
        },
        {
          "name": "WEB-01 · GET /cursos?nivel=BASICO -> 200 filtrado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('WEB-01 · GET /cursos?nivel=BASICO responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('WEB-06 · el filtro de nivel se aplica', function () {",
                  "    const b = pm.response.json();",
                  "    b.data.forEach(c => {",
                  "        pm.expect(String(c.nivel).toUpperCase()).to.eql('BASICO');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/cursos?nivel=BASICO",
