        {
          "name": "WEB-01 · GET /search?q=... -> 200 con envelope SearchHitDTO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('WEB-01 · GET /search responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('WEB-06 · cada hit envuelto en {id, score, source, highlight}', function () {",
                  "    const b = pm.response.json();",
                  "    const d = b.data;",
                  "    pm.expect(d).to.have.property('query');",
                  "    pm.expect(d).to.have.property('total');",
                  "    ['cursos','lecciones','conceptos','faqs'].forEach(k => {",
                  "        pm.expect(d).to.have.property(k);",
                  "        d[k].forEach(hit => {",
                  "            pm.expect(hit).to.have.property('id');",
                  "            pm.expect(hit).to.have.property('source');",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/search?q=ohm&page=0&size=10",
              "host": ["{{baseUrl}}"], "path": ["search"],
              "query": [
                { "key": "q", "value": "ohm" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
